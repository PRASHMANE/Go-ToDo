# /etc/go-todo/gateway.env
PORT=8080
GIN_MODE=release
LOG_LEVEL=info
AUTH_SERVICE_URL=http://127.0.0.1:8081
TODO_SERVICE_URL=http://127.0.0.1:8082
ACTIVITY_SERVICE_URL=http://127.0.0.1:8083
# MUST equal JWT_SECRET in auth.env
JWT_SECRET=CHANGE_ME
JWT_ISSUER=go-todo-auth
# Browser origin(s) of your site
CORS_ORIGINS=https://todo.example.com
# nginx runs on the same machine → trust it so rate limiting sees the real client IP
TRUSTED_PROXIES=127.0.0.1
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
